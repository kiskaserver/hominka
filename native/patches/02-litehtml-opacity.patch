+// Малює елемент разом із нащадками під шаром прозорості.
+//
+// Повертає false, якщо елемент непрозорий і його треба малювати як завжди.
+//
+// Чому цілком і в одному місці: звичайним шляхом фон елемента малюється
+// одним проходом (draw_block/draw_inlines), а його вміст — наступним
+// проходом того ж батька. Під шар мають потрапити обидва, інакше
+// прозорість накриє лише половину.
+static bool draw_opacity_group(litehtml::uint_ptr hdc, const litehtml::position& pos,
+                               const litehtml::position* clip,
+                               const std::shared_ptr<litehtml::render_item>& el)
+{
+    const float opacity = el->src_el()->css().get_opacity();
+    if(opacity >= 1.0f) return false;
+
+    litehtml::document_container* container = el->src_el()->get_document()->container();
+    container->push_opacity(opacity);
+    el->src_el()->draw(hdc, pos.x, pos.y, clip, el);
+    el->draw_stacking_context(hdc, pos.x, pos.y, clip, false);
+    container->pop_opacity();
+    return true;
+}
